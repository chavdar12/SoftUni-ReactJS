rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && role() == 'admin'; }

    // Self-signup may only create a patient. Admins are promoted by hand in the console.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if (signedIn() && request.auth.uid == uid && request.resource.data.role == 'patient') || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /appointments/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in [resource.data.patientId, resource.data.doctorId]);
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid && request.resource.data.status == 'active';
      allow update: if signedIn() && request.auth.uid in [resource.data.patientId, resource.data.doctorId]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedBy']);
    }

    match /prescriptions/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in [resource.data.patientId, resource.data.doctorId]);
      allow create: if signedIn() && role() == 'doctor' && request.resource.data.doctorId == request.auth.uid;
    }
  }
}
