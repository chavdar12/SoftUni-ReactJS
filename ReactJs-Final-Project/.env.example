# Used for the Kubernetes secret (see README) and by `npm run dev:*` in server/.
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@hms.local
ADMIN_PASSWORD=change-me
# Local mail testing: docker run -d -p 1080:1080 -p 1025:1025 maildev/maildev:3.0.0  (inbox: http://localhost:1080)
SMTP_URL=smtp://localhost:1025
# Optional: base URL used in password-reset emails, and the clinic's timezone for working hours.
# APP_URL=http://localhost:8080
# CLINIC_TZ=Europe/Sofia
